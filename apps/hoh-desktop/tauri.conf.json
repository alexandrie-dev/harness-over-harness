{
  "productName": "HoH",
  "version": "0.1.0",
  "identifier": "local.hoh.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": "/usr/bin/env -i /bin/bash -p ../../ui/scripts/build.sh"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": true,
        "title": "HoH",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 360,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main",
        "approval"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
