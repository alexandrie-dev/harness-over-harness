  "name": "@hoh/window",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "/bin/bash -p scripts/build.sh",
    "snapshot": "python3 scripts/offline.py node scripts/snapshot.mjs",
    "supply": "../scripts/ui-supply-check.sh",
    "build:offline": "/usr/bin/env -i /usr/bin/python3 -I scripts/offline.py /bin/sh -c 'pnpm install --frozen-lockfile --offline && ../scripts/ui-supply-check.sh && ./node_modules/.bin/tsc --noEmit && ./node_modules/.bin/vite build && node scripts/check-dist.mjs'",
    "test:chat:core": "/usr/bin/env -i /usr/bin/python3 -I scripts/offline.py node tests/chat/run.mjs",
    "test:chat": "/usr/bin/env -i /usr/bin/python3 -I scripts/offline.py node tests/chat/behavior.mjs"
  },
