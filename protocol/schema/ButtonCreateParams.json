{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ButtonCreateParams",
  "type": "object",
  "properties": {
    "draft": {
      "$ref": "#/$defs/ButtonDraft"
    }
  },
  "required": [
    "draft"
  ],
  "$defs": {
    "ButtonDraft": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ButtonTarget"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ButtonInput"
          }
        },
        "employeeId": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "target"
      ]
    },
    "ButtonTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "prompt"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
    "ButtonInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label",
        "required"
      ]
    }
  }
}
