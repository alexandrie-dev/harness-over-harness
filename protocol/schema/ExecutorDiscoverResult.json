{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutorDiscoverResult",
  "type": "object",
  "properties": {
    "executor": {
      "type": "string"
    },
    "installed": {
      "type": "boolean"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "versionStatus": {
      "$ref": "#/$defs/ExecutorVersionStatus"
    },
    "auth": {
      "$ref": "#/$defs/ExecutorAuth"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExecutorModel"
      }
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutorDiscoveryFailure"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "executor",
    "installed",
    "versionStatus",
    "auth",
    "models"
  ],
  "$defs": {
    "ExecutorVersionStatus": {
      "type": "string",
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    },
    "ExecutorAuth": {
      "type": "string",
      "enum": [
        "authenticated",
        "unauthenticated",
        "unknown"
      ]
    },
    "ExecutorModel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "isDefault": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ]
    },
    "ExecutorDiscoveryFailure": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timeout"
            },
            "operation": {
              "$ref": "#/$defs/ExecutorDiscoveryOperation"
            },
            "timeoutSeconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "operation",
            "timeoutSeconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "exit"
            },
            "operation": {
              "$ref": "#/$defs/ExecutorDiscoveryOperation"
            },
            "exitCode": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            }
          },
          "required": [
            "kind",
            "operation"
          ]
        }
      ]
    },
    "ExecutorDiscoveryOperation": {
      "type": "string",
      "enum": [
        "version",
        "initialize"
      ]
    }
  },
  "x-method": "hoh/executor/discover"
}
