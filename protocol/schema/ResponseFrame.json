{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResponseFrame",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/Version"
        },
        "id": {
          "$ref": "#/$defs/JsonRpcId"
        },
        "result": true
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/Version"
        },
        "id": {
          "$ref": "#/$defs/JsonRpcId"
        },
        "error": {
          "$ref": "#/$defs/RpcError"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ]
    }
  ],
  "$defs": {
    "Version": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "JsonRpcId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number",
          "format": "double"
        }
      ]
    },
    "RpcError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "data": true
      },
      "required": [
        "message"
      ]
    }
  }
}
