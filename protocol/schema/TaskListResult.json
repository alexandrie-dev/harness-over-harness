{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_Task",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Task"
  },
  "$defs": {
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "permissions": {
          "$ref": "#/$defs/Permissions"
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "version",
        "permissions",
        "active"
      ]
    },
    "Permissions": {
      "type": "object",
      "properties": {
        "internet": {
          "$ref": "#/$defs/InternetMode"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "folders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writeFiles": {
          "type": "boolean"
        },
        "programs": {
          "type": "boolean"
        },
        "programNetwork": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actAsUser": {
          "type": "boolean"
        }
      },
      "required": [
        "internet",
        "domains",
        "folders",
        "writeFiles",
        "programs",
        "programNetwork",
        "actAsUser"
      ]
    },
    "InternetMode": {
      "type": "string",
      "enum": [
        "ask",
        "public",
        "deny"
      ]
    }
  },
  "x-method": "hoh/task/list"
}
