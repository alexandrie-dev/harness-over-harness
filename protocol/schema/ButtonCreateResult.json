{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Button",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ButtonTarget"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ButtonInput"
      }
    },
    "employeeId": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "label",
    "target"
  ],
  "$defs": {
    "ButtonTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "prompt"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
    "ButtonInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label",
        "required"
      ]
    }
  },
  "x-method": "hoh/button/create"
}
