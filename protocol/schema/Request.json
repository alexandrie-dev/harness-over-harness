  "$defs": {
    "InitializeParams": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string"
        },
        "approvalRequests": {
          "type": "boolean"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": "string"
        },
        "maxTokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "userQuestions": {
              "type": "boolean"
            },
            "approvals": {
              "type": "string",
              "enum": [
                "host"
              ]
            }
          }
        },
        "hoh": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "approvalKey": {
              "description": "64 lowercase hex characters, native host only; never forward to JS.",
              "type": "string"
            }
          },
          "required": [
            "protocolVersion"
          ]
        }
      },
      "required": [
        "cwd",
        "provider",
        "model"
      ]
    },
    "SessionPromptParams": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "contentBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SdkPromptContentBlock"
          }
        }
      },
      "required": [
        "sessionId",
        "contentBlocks"
      ]
    },
    "SdkPromptContentBlock": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentBlock"
        },
        {
          "$ref": "#/$defs/SdkEncodedImageBlock"
        }
      ]
    },
    "ContentBlock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "reasoning"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "attachment": {
              "$ref": "#/$defs/ImageAttachmentRef"
            },
            "offloaded": {
              "description": "Literal true, rather than a bool that would admit false.",
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "type",
            "attachment"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "file"
            },
            "attachment": {
              "$ref": "#/$defs/FileAttachmentRef"
            }
          },
          "required": [
            "type",
            "attachment"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tool-call"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "name",
            "arguments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tool-addition"
            },
            "toolName": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "toolName"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tool-removal"
            },
            "toolName": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "toolName"
          ]
        }
      ]
    },
    "ImageAttachmentRef": {
      "type": "object",
      "properties": {
        "attachmentId": {
          "type": "string"
        },
        "mediaType": {
          "$ref": "#/$defs/ImageMediaType"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "originalDimensions": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "width",
            "height"
          ]
        }
      },
      "required": [
        "attachmentId",
        "mediaType",
        "bytes",
        "width",
        "height"
      ]
    },
    "ImageMediaType": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif"
      ]
    },
    "FileAttachmentRef": {
      "type": "object",
      "properties": {
        "attachmentId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "attachmentId",
        "name",
        "bytes"
      ]
    },
    "SdkEncodedImageBlock": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/ImageTag"
        },
        "data": {
          "type": "string"
        },
        "mimeType": {
          "$ref": "#/$defs/ImageMediaType"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "data",
        "mimeType"
      ]
    },
    "ImageTag": {
      "type": "string",
      "enum": [
        "image"
      ]
    },
    "SessionQueryParams": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "contentBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SdkPromptContentBlock"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "sessionId",
        "contentBlocks"
      ]
    },
