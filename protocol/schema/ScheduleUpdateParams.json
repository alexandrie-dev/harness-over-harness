{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScheduleUpdateParams",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "patch": {
      "$ref": "#/$defs/SchedulePatch"
    }
  },
  "required": [
    "id",
    "patch"
  ],
  "$defs": {
    "SchedulePatch": {
      "type": "object",
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "taskId": {
                  "type": "string"
                },
                "employeeId": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "taskId",
                "employeeId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "employeeId": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "employeeId",
                "prompt"
              ]
            }
          ]
        },
        "when": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "once"
                },
                "at": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "at"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "interval"
                },
                "everyMs": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "everyMs"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "cron"
                },
                "expression": {
                  "type": "string"
                },
                "timezone": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "expression",
                "timezone"
              ]
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
