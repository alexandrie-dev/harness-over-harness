{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactRenderResult",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "pages"
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RenderedPage"
          }
        },
        "totalPages": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "pages",
        "totalPages"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "table"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": true
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "columns",
        "rows",
        "truncated"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "text",
        "truncated"
      ]
    }
  ],
  "$defs": {
    "RenderedPage": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mime": {
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/ArtifactEncoding"
        },
        "data": {
          "type": "string"
        }
      },
      "required": [
        "page",
        "mime",
        "encoding",
        "data"
      ]
    },
    "ArtifactEncoding": {
      "type": "string",
      "enum": [
        "utf8",
        "base64"
      ]
    }
  },
  "x-method": "hoh/artifact/render"
}
