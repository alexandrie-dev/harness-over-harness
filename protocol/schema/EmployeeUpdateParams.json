{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmployeeUpdateParams",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "patch": {
      "$ref": "#/$defs/EmployeePatch"
    },
    "rev": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "patch",
    "rev"
  ],
  "$defs": {
    "EmployeePatch": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "object",
          "properties": {
            "internet": {
              "$ref": "#/$defs/InternetMode"
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "folders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "writeFiles": {
              "type": "boolean"
            },
            "programs": {
              "type": "boolean"
            },
            "programNetwork": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "actAsUser": {
              "type": "boolean"
            }
          },
          "required": [
            "internet",
            "domains",
            "folders",
            "writeFiles",
            "programs",
            "programNetwork",
            "actAsUser"
          ]
        }
      }
    },
    "InternetMode": {
      "type": "string",
      "enum": [
        "ask",
        "public",
        "deny"
      ]
    }
  }
}
