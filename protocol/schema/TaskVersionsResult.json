{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_TaskVersion",
  "type": "array",
  "items": {
    "$ref": "#/$defs/TaskVersion"
  },
  "$defs": {
    "TaskVersion": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "createdAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "createdAt",
        "description"
      ]
    }
  },
  "x-method": "hoh/task/versions"
}
