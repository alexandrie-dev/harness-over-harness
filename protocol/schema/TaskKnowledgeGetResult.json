{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskKnowledge",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/KnowledgeSource"
      }
    },
    "artifactIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "rules",
    "sources",
    "artifactIds"
  ],
  "$defs": {
    "KnowledgeSource": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "uri"
      ]
    }
  },
  "x-method": "hoh/task/knowledge/get"
}
