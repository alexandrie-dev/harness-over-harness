{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalRequestParams",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string"
    },
    "toolName": {
      "type": "string"
    },
    "callId": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "humanText": {
      "type": "string"
    },
    "actionHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "sessionId",
    "toolName"
  ]
}
