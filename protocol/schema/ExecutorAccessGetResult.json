{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutorAccessGetResult",
  "type": "object",
  "properties": {
    "executor": {
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/ExecutorAccessMode"
    },
    "effective": {
      "$ref": "#/$defs/ExecutorEffectiveAccess"
    },
    "selected": {
      "$ref": "#/$defs/ExecutorSelection"
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutorSessionAccess"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "executor",
    "mode",
    "effective",
    "selected"
  ],
  "$defs": {
    "ExecutorAccessMode": {
      "type": "string",
      "enum": [
        "confirm",
        "full"
      ]
    },
    "ExecutorEffectiveAccess": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ExecutorAccessMode"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "flags",
        "text"
      ]
    },
    "ExecutorSelection": {
      "type": "object",
      "properties": {
        "executor": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ExecutorSessionAccess": {
      "type": "object",
      "properties": {
        "executor": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "privacy": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutorAccessMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "running": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutorAccessMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimeMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutorRuntimeMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "runningRuntimeMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutorRunningRuntimeMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "builtin": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pending": {
          "type": "boolean"
        }
      },
      "required": [
        "pending"
      ]
    },
    "ExecutorRuntimeMode": {
      "type": "string",
      "enum": [
        "confirm",
        "auto-accept-edits",
        "auto",
        "full"
      ]
    },
    "ExecutorRunningRuntimeMode": {
      "type": "string",
      "enum": [
        "confirm",
        "auto-accept-edits",
        "auto",
        "full",
        "plan"
      ]
    }
  },
  "x-method": "hoh/executor/access/get"
}
