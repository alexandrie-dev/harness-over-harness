{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutorAccessSetParams",
  "type": "object",
  "properties": {
    "executor": {
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/ExecutorAccessMode"
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtimeMode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutorRuntimeMode"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "executor",
    "mode"
  ],
  "$defs": {
    "ExecutorAccessMode": {
      "type": "string",
      "enum": [
        "confirm",
        "full"
      ]
    },
    "ExecutorRuntimeMode": {
      "type": "string",
      "enum": [
        "confirm",
        "auto-accept-edits",
        "auto",
        "full"
      ]
    }
  }
}
