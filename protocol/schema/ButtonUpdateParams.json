{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ButtonUpdateParams",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "patch": {
      "$ref": "#/$defs/ButtonPatch"
    }
  },
  "required": [
    "id",
    "patch"
  ],
  "$defs": {
    "ButtonPatch": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "task"
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "id"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "prompt"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "text"
              ]
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ButtonInput"
          }
        },
        "employeeId": {
          "type": "string"
        }
      }
    },
    "ButtonInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label",
        "required"
      ]
    }
  }
}
